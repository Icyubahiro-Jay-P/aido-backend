# Copy to .env and fill in your values: cp .env.example .env

# MongoDB connection string (local: mongodb://localhost:27017/aido_group_company_ltd_db)
MONGO_URI=mongodb://localhost:27017/aido_group_company_ltd_db

# Secret used to sign/verify JWTs
JWT_SECRET=change-me-to-a-long-random-string

# Server port
PORT=5000

# SMTP (optional - falls back to a one-off Ethereal test account when unset)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
FROM_NAME=AIDO Group
FROM_EMAIL=

# Destination inbox for the public contact form
CONTACT_EMAIL=
